# Application
APP_NAME=SimpleIQ
APP_VERSION=0.1.0
DEBUG=True
ENVIRONMENT=development
LOG_LEVEL=INFO

# API
API_V1_PREFIX=/api/v1
PROJECT_NAME="SimpleIQ API"
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://localhost"]

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/simpleiq
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
DATABASE_POOL_TIMEOUT=30

# ClickHouse (Analytics Database)
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_DATABASE=simpleiq_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_DB=0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# AI/ML
LLAMA_MODEL_PATH=./models/llama-2-7b-chat.gguf
OPENAI_API_KEY=your-openai-api-key-if-using-openai
MAX_TOKENS=2000
TEMPERATURE=0.7

# Google Sheets Integration
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials/google-service-account.json
GOOGLE_SCOPES=["https://www.googleapis.com/auth/spreadsheets.readonly", "https://www.googleapis.com/auth/drive.readonly"]

# AWS (if using S3 for storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET_NAME=simpleiq-data

# Stripe (for billing)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@simpleiq.io
EMAILS_FROM_NAME=SimpleIQ

# Monitoring
SENTRY_DSN=
PROMETHEUS_PORT=9090

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Feature Flags
ENABLE_SIGNUP=True
ENABLE_AI_FEATURES=True
ENABLE_PREMIUM_FEATURES=False